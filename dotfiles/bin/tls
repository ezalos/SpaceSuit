#!/usr/bin/env bash
# ABOUTME: Terminal view of every tmux window and its Claude session.
# ABOUTME: Thin wrapper; the grid lives in ~/42/SpaceSuit/agents_dashboard/termview.py.
set -uo pipefail
# --directory (not --project) changes cwd before running: pyproject.toml has
# no [build-system], so `agents_dashboard` is never installed into .venv and
# `python -m agents_dashboard` only resolves via cwd. --project alone picks
# the venv but leaves cwd wherever the caller invoked us from, which broke
# every invocation except from ~/42/SpaceSuit itself.
#
# No `exec` here: we want to inspect the exit status ourselves so a genuine
# failure is unmistakable, not just numerically non-zero. `set -e` is
# deliberately NOT set - it would abort the script the instant the command
# below fails, before the diagnostic below ever ran.
/home/ezalos/.local/bin/uv run --directory /home/ezalos/42/SpaceSuit \
  python -m agents_dashboard tls "$@"
status=$?
if [ "$status" -ne 0 ]; then
  echo "tls: agents_dashboard failed (exit $status)" >&2
fi
exit "$status"
