#!/usr/bin/env bash
# ABOUTME: Thin wrapper putting the deep_research CLI on PATH.
# ABOUTME: Runs through uv from the repo so the package resolves without installation.
set -euo pipefail
REPO="${SPACESUIT_REPO:-$HOME/42/SpaceSuit}"
# PYTHONPATH rather than --directory: the package is not installed into the venv, so the
# repo root must be on sys.path, but the working directory must stay the CALLER's, or a
# relative --out would resolve against the repo instead of where the user is standing.
PYTHONPATH="$REPO${PYTHONPATH:+:$PYTHONPATH}" exec uv run --project "$REPO" python -m deep_research "$@"
