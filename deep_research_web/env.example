# ABOUTME: Config for deep-research-web; copy to ~/.config/deep-research-web/env (mode 0600).
# ABOUTME: No secret lives here; the credential is the browser profile directory.
DEEP_RESEARCH_WEB_MODEL=claude-fable-5-1
DEEP_RESEARCH_WEB_PROJECT="Deep research"
DEEP_RESEARCH_WEB_RUNS_ROOT=~/research-runs
DEEP_RESEARCH_WEB_PROFILE=~/.local/state/deep-research-web/chrome-profile
# Root of the saved per-account profiles (default ~/.local/state/deep-research-web/profiles)
# DEEP_RESEARCH_WEB_PROFILES=~/.local/state/deep-research-web/profiles
# Only for a SpaceSuit checkout that is not the parent of this project (default: the parent).
# DEEP_RESEARCH_WEB_SPACESUIT=~/42/SpaceSuit
# Library every collected run is copied into as <start date>-<name>/ (unset: no copy). A session commits it.
# DEEP_RESEARCH_WEB_ARCHIVE_ROOT=~/some-repo/deep-research
