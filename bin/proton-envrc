#!/usr/bin/env bash
# ABOUTME: Emit .envrc lines for one Proton context's vault, using Louis's API-credential
# ABOUTME: convention: "API Key" field = env var name, "Secret" field = the value.
set -euo pipefail

PAT_DIR="$HOME/.claude/channels/proton-pass"

usage() {
  local ctxs
  ctxs=$(cd "$PAT_DIR" 2>/dev/null && ls ./*.pat 2>/dev/null | sed 's|^\./||;s/\.pat$//' | paste -sd'|' -) || ctxs=""
  echo "usage: proton-envrc <${ctxs:-no tokens minted}> [--resolve]   (>> a project .envrc)" >&2
  echo "  --resolve: emit 'use proton <ctx> resolve' (project repos, eager mode)" >&2
  exit 1
}

CTX="${1:-}"; MODE="${2:-}"
[ -n "$CTX" ] || usage
[ -r "$PAT_DIR/$CTX.pat" ] || { echo "proton-envrc: no token for context '$CTX' at $PAT_DIR/$CTX.pat" >&2; usage; }

export PROTON_AGENT_CONTEXT="$CTX"
export PROTON_PASS_SESSION_DIR="$PAT_DIR/session-$CTX"
export PROTON_PASS_AGENT_REASON="generate .envrc references"

# Each context token is scoped to exactly one vault: derive it, never hardcode it.
vjson="$(proton-agent vault list --output json)"
nvaults="$(jq '.vaults | length' <<<"$vjson")"
[ "$nvaults" = 1 ] || { echo "proton-envrc: context '$CTX' sees $nvaults vaults, expected exactly 1" >&2; exit 1; }
share="$(jq -r '.vaults[0].share_id' <<<"$vjson")"
vault="$(jq -r '.vaults[0].name' <<<"$vjson")"

echo "# --- Proton secrets via context '$CTX' (generated by proton-envrc) ---"
proton-agent item list "$vault" --output json | jq -r '.items[] | [.id, .title] | @tsv' \
| while IFS=$'\t' read -r id title; do
    var="$(proton-agent item view --vault-name "$vault" --item-id "$id" --field 'API Key' 2>/dev/null || true)"
    var="$(printf '%s' "$var" | tr -d '[:space:]')"   # tolerate stray spaces in the field
    if [ -z "$var" ]; then
      printf "# skip (no 'API Key' var name set): %s\n" "$title"
    elif ! printf '%s' "$var" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$'; then
      printf "# skip ('API Key' not a valid identifier: %s): %s\n" "$var" "$title"
    else
      printf "export %s='pass://%s/%s/Secret'   # %s\n" "$var" "$share" "$id" "$title"
    fi
  done
# The `use proton` line comes AFTER the exports: in resolve mode the direnv helper
# scans the env for pass:// values, so placement is the ordering contract.
if [ "$MODE" = "--resolve" ]; then
  echo "use proton $CTX resolve"
else
  [ -z "$MODE" ] || { echo "proton-envrc: unknown flag '$MODE'" >&2; usage; }
  echo "use proton $CTX"
fi
