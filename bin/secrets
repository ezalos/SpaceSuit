#!/usr/bin/env bash
# ABOUTME: Prefix-free lazy resolver: runs a command with pass:// refs resolved into its env,
# ABOUTME: reading ./.envrc for context + refs when direnv never ran. No value ever printed.
set -euo pipefail

ENVRC="./.envrc"
# printf, not $'\t': BSD/macOS sed does not interpret \t in replacement text (only GNU sed
# does), so the tab-delimited name/ref contract below needs a real tab character spliced in.
TAB="$(printf '\t')"

usage() {
  cat <<'EOF'
secrets: resolve pass:// refs for a child process (values never printed).
  secrets run -- <cmd>   run <cmd> with refs from env or ./.envrc resolved into its env
  secrets check          report each ref reachable from cwd: ok | missing | denied | error
  secrets names          list variable names refs would provide (no values, no refs)
EOF
  exit "${1:-0}"
}

envrc_ctx() {
  [ -r "$ENVRC" ] || return 0
  awk '$1=="use" && $2=="proton" {print $3; exit}' "$ENVRC"
}

# Narrow grammar, we control the writer (proton-envrc):  export NAME='pass://...'   # comment
envrc_refs() {
  [ -r "$ENVRC" ] || return 0
  sed -nE "s|^export ([A-Za-z_][A-Za-z0-9_]*)='(pass://[^']+)'.*|\1${TAB}\2|p" "$ENVRC"
}

# Any pass:// export line that does NOT match the narrow single-quote grammar above (e.g.
# double-quoted or unquoted): surfaced by name only, never silently dropped. See
# warn_unsupported_refs, which turns this into a loud stderr warning.
envrc_bad_ref_names() {
  [ -r "$ENVRC" ] || return 0
  grep -E "^export [A-Za-z_][A-Za-z0-9_]*=.*pass://" "$ENVRC" \
    | grep -vE "^export [A-Za-z_][A-Za-z0-9_]*='pass://[^']+'" \
    | sed -E 's/^export ([A-Za-z_][A-Za-z0-9_]*)=.*/\1/' \
    | awk '!seen[$0]++' \
    || true   # grep exits 1 on zero matches (the common case); pipefail must not trip set -e
}

warn_unsupported_refs() {
  local name
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    echo "secrets: WARNING: ${name} looks like a ref but does not match the supported grammar (use single quotes); ignoring" >&2
  done <<EOF
$(envrc_bad_ref_names)
EOF
}

env_refs() {
  env | sed -nE "s|^([A-Za-z_][A-Za-z0-9_]*)=(pass://.*)\$|\1${TAB}\2|p"
}

all_refs() { { env_refs; envrc_refs; } | awk -F'\t' 'NF==2 && !seen[$1]++'; }

bind_ctx() {
  local ctx
  ctx="${PROTON_AGENT_CONTEXT:-$(envrc_ctx)}"
  export PROTON_AGENT_CONTEXT="${ctx:-general}"
  export PROTON_PASS_AGENT_REASON="${PROTON_PASS_AGENT_REASON:-secrets:$(basename "$PWD")}"
}

cmd="${1:-}"
if [ $# -gt 0 ]; then shift; fi     # NOT `[ ... ] && shift`: a false test would trip set -e
case "$cmd" in
  ""|-h|--help) usage ;;
  run)
    warn_unsupported_refs
    if [ "${1:-}" = "--" ]; then shift; fi
    [ $# -gt 0 ] || { echo "secrets run: no command given" >&2; usage 2; }
    if [ -z "$(all_refs)" ]; then
      exec "$@"                       # no refs anywhere: plain passthrough, no Proton round trip
    fi
    # inject ./.envrc refs unless the name is already set (already-resolved values win)
    while IFS=$'\t' read -r name ref; do
      [ -n "$name" ] || continue
      if [ -z "${!name+x}" ]; then export "$name=$ref"; fi
    done <<EOF
$(envrc_refs)
EOF
    bind_ctx
    exec proton-agent run -- "$@"
    ;;
  check)
    warn_unsupported_refs
    bind_ctx
    rc=0
    while IFS=$'\t' read -r name ref; do
      [ -n "$name" ] || continue
      # stdout (the value) is discarded unseen; only stderr is captured for the verdict
      if err="$(proton-agent item view "$ref" 2>&1 >/dev/null)"; then
        echo "$name: ok"
      else
        case "$err" in
          # "Error finding item"/"...vault" is the real pass-cli wording for a bad item/share
          # id (verified live 2026-07-13 against the money vault); NotFound/"Not Found" are
          # kept for the test fake, which uses its own (simpler) wording.
          *NotFound*|*[Nn]ot\ [Ff]ound*|*"Error finding item"*|*"Error finding vault"*) echo "$name: missing" ;;
          *NotAllowed*|*[Dd]enied*)      echo "$name: denied" ;;
          *)                             echo "$name: error" ;;
        esac
        rc=1
      fi
    done <<EOF
$(all_refs)
EOF
    exit "$rc"
    ;;
  names)
    warn_unsupported_refs
    all_refs | cut -f1
    ;;
  *) echo "secrets: unknown command '$cmd'" >&2; usage 2 ;;
esac
