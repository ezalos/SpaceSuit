#!/usr/bin/env bash
# ABOUTME: Front door for develle.fr DNS sync; cwd-agnostic, resolves secrets via `secrets run`.
# ABOUTME: Wraps ~/42/TheStables/network/domains/cloudflare-dns/dns.sh; never requires direnv or a cd.
set -euo pipefail
cd "$HOME/42/TheStables/network/domains"
exec secrets run -- ./cloudflare-dns/dns.sh "$@"
