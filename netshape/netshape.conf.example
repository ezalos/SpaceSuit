# ABOUTME: Example netshape policy. Copy to /etc/netshape.conf, root:root 0644.
# ABOUTME: Per-host and per-site, so it lives outside git like ~/.config/netwatch/env.
#
# The whole policy is EGRESS_MBIT. Everything else has a working default.
#
#   netshape status      does the wire match this file?
#   netshape set 380     cap egress at 380 Mbit/s, now and at every boot
#   netshape off         no cap (the default)
#
# Choosing the number: 90% of the uplink's *measured* rate, from
# `netwatch bufferbloat`. Shaping has to sit below the real uplink or the queue
# stays in the router where nothing can manage it. Never copy a number between
# sites — the answer is set by the line, not by the machine. Re-measure after
# any move, and write down what you measured.

# Which interface faces the uplink. `auto` reads the default route.
IFACE=auto

# Egress cap in Mbit/s. 0 = no shaping.
#
# 0 is the correct value on a line that measures grade A: a cap you do not need
# costs throughput and buys nothing. Turn it up when a measurement says so — a
# `netwatch bufferbloat` grade of B or worse, a gateway that restarts under
# sustained upload, or someone in the house complaining while this machine works.
EGRESS_MBIT=0

# CAKE options. besteffort ignores DSCP and shares fairly between flows; nat
# looks through masquerading so each container counts as its own host.
# diffserv4 instead of besteffort if traffic on this host is ever DSCP-marked.
OPTIONS=besteffort nat

# Reachability canary for the rollback guard. Empty = the default gateway.
# If applying a cap costs us this address, the cap is reverted automatically.
PROBE=
